feature ss01 {
  featureNames {
    name 3 1 0x409 "Old-style Demestvenny";
  };

 script DFLT;
     language dflt ;
      lookup DemestvennySpecificKerning;

 script cyrl;
     language dflt ;
      lookup DemestvennySpecificKerning;

 script latn;
     language dflt ;
      lookup DemestvennySpecificKerning;
} ss01;

feature ss02 {
  featureNames {
    name 3 1 0x409 "New-style Demestvenny";
  };

 script DFLT;
     language dflt ;
      lookup DemestvennySpecificKerning;

 script cyrl;
     language dflt ;
      lookup DemestvennySpecificKerning;

 script latn;
     language dflt ;
      lookup DemestvennySpecificKerning;
} ss02;

feature ss10 {
  featureNames {
    name 3 1 0x409 "Place capital letters inline";
  };

 script DFLT;
     language dflt ;
      lookup ss10EqualBaselineLookup;

 script cyrl;
     language dflt ;
      lookup ss10EqualBaselineLookup;

 script grek;
     language dflt ;
      lookup ss10EqualBaselineLookup;

 script latn;
     language dflt ;
      lookup ss10EqualBaselineLookup;
} ss10;

feature mark {

 script DFLT;
     language dflt ;
      lookup markBlackMarkPositioning;
      lookup markCinnabarMarkPositioning;
      lookup markMarkPositioningforSlavonic;

 script cyrl;
     language dflt ;
      lookup markBlackMarkPositioning;
      lookup markCinnabarMarkPositioning;
      lookup markMarkPositioningforSlavonic;

 script latn;
     language dflt ;
      lookup markBlackMarkPositioning;
      lookup markCinnabarMarkPositioning;
      lookup markMarkPositioningforSlavonic;
} mark;

feature mkmk {

 script DFLT;
