feature ccmp {

 script DFLT;
     language dflt ;
      lookup Supportfordeprecatedmappingsccmp;
      lookup ccmpGlyphCompositionDecompositionforSlavonic;
      lookup ccmpSecondaryLigaturesforSlavonic;
      lookup ccmpContextualDotRemovalforLatin;
      lookup ZnamennyPriznakification;
      lookup ZnamennyPriznakificationRound2;
      lookup PrecomposedformsforZnamennyNotation;
      lookup PrecomposedformsforZnamennyRound2;
      lookup PrecomposedformsforZnamennyRound3;
      lookup ccmpZnamennyLigatures;
      lookup PostcompositionPriznakification;
      lookup ccmpMedialFormofRavno;

 script cyrl;
     language dflt ;
      lookup Supportfordeprecatedmappingsccmp;
      lookup ccmpGlyphCompositionDecompositionforSlavonic;
      lookup ccmpSecondaryLigaturesforSlavonic;
      lookup ZnamennyPriznakification;
      lookup ZnamennyPriznakificationRound2;
      lookup PrecomposedformsforZnamennyNotation;
      lookup PrecomposedformsforZnamennyRound2;
      lookup PrecomposedformsforZnamennyRound3;
      lookup ccmpZnamennyLigatures;
      lookup PostcompositionPriznakification;
      lookup ccmpMedialFormofRavno;

 script latn;
     language dflt ;
      lookup Supportfordeprecatedmappingsccmp;
      lookup ccmpGlyphCompositionDecompositionforSlavonic;
      lookup ccmpSecondaryLigaturesforSlavonic;
      lookup ccmpContextualDotRemovalforLatin;
      lookup ZnamennyPriznakification;
      lookup ZnamennyPriznakificationRound2;
      lookup PrecomposedformsforZnamennyNotation;
      lookup PrecomposedformsforZnamennyRound2;
      lookup PrecomposedformsforZnamennyRound3;
      lookup ccmpZnamennyLigatures;
      lookup PostcompositionPriznakification;
      lookup ccmpMedialFormofRavno;
} ccmp;

feature liga {

 script latn;
     language dflt ;
      lookup ligaStandardLigaturesinLatin;
} liga;

feature salt {

 script DFLT;
     language dflt ;
      lookup saltStylisticAlternativesforSlavonic;
      lookup StylisticAlternativesforZnamennysalt;

 script cyrl;
     language dflt ;
      lookup saltStylisticAlternativesforSlavonic;
      lookup StylisticAlternativesforZnamennysalt;

 script latn;
     language dflt ;
      lookup saltStylisticAlternativesforSlavonic;
      lookup StylisticAlternativesforZnamennysalt;
} salt;

feature ss02 {
  featureNames {
    name 3 1 0x409 "New-style Demestvenny";
  };

 script DFLT;
     language dflt ;
      lookup ss02KalashnikovMechikVariants;

 script cyrl;
     language dflt ;
      lookup ss02KalashnikovMechikVariants;

 script latn;
     language dflt ;
      lookup ss02KalashnikovMechikVariants;
} ss02;

feature ss03 {
  featureNames {
    name 3 1 0x409 "New-style Contracted Demestvenny";
  };

 script DFLT;
     language dflt ;
      lookup ss02KalashnikovMechikVariants;
      lookup ContextualPreContraction;

 script cyrl;
     language dflt ;
      lookup ss02KalashnikovMechikVariants;
      lookup ContextualPreContraction;

 script latn;
     language dflt ;
      lookup ss02KalashnikovMechikVariants;
      lookup ContextualPreContraction;
} ss03;

feature ss04 {
  featureNames {
    name 3 1 0x409 "Turn off coloring of cinnabar marks";
  };

 script DFLT;
     language dflt ;
      lookup ss04StyleSet4BlackMarks;

 script cyrl;
     language dflt ;
      lookup ss04StyleSet4BlackMarks;

 script latn;
     language dflt ;
      lookup ss04StyleSet4BlackMarks;
} ss04;

